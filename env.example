# Configurações do WhatsApp
WHATSAPP_SESSION_NAME=simplou

# Configurações do Banco de Dados
POSTGRES_DB=simplou
POSTGRES_USER=simplou
POSTGRES_PASSWORD=simplou123
DATABASE_URL=postgresql://simplou:simplou123@localhost:5432/simplou

# Configurações da IA
GEMINI_API_KEY=your_gemini_api_key_here

# Configurações do Redis (OPCIONAL - para sessão do WhatsApp)
# Se não configurado, usará armazenamento local
REDIS_URL=redis://localhost:6379

# Configurações do ambiente
NODE_ENV=development
PORT=3000

# ── WhatsApp Provider ──────────────────────────────
# Valores: baileys | meta
# Atualmente: baileys (padrão)
WHATSAPP_PROVIDER=baileys

# ── Meta Cloud API (preencher ao migrar para API oficial) ──
META_WHATSAPP_TOKEN=        # Token permanente do sistema — Meta Business Manager
META_PHONE_NUMBER_ID=       # ID do número de telefone — WhatsApp Business Platform
META_API_VERSION=v19.0      # Versão da Graph API
META_WEBHOOK_VERIFY_TOKEN=  # Token secreto para verificação do webhook (você define)

# ── Monitoramento ──────────────────────────────────
SENTRY_DSN=